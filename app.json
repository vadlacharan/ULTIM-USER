{
  "expo": {
    "name": "ultim",
    "slug": "ultim",
    "version": "4.0.2",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ultim.app",
      "buildNumber": "16",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow ULTIM to access your location to discover nearby sports and fitness centers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow ULTIM to access your location to discover nearby sports and fitness centers."
      }
    },
    "android": {
      "package": "com.ultim.app",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0A0B0D"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ULTIM to access your location to discover nearby sports and fitness centers."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#FF6A1A"
        }
      ],
      "expo-secure-store",
      "expo-splash-screen",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "51a1e8d8-967d-427f-b59e-91bfe37abb17"
      }
    }
  }
}
